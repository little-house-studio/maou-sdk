{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maou",
  "version": "../package.json",
  "identifier": "studio.littlehouse.maou.app",
  "build": {
    "beforeDevCommand": "pnpm run build:hub && pnpm run dev:client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Little House Studio",
    "shortDescription": "Maou 桌面客户端",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
