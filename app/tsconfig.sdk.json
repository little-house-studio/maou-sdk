{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/sdk",
    "rootDir": "src/client",
    "isolatedModules": true
  },
  "include": [
    "src/client/slots/**/*.ts",
    "src/client/slots/**/*.tsx",
    "src/client/ports/public.ts",
    "src/client/shell/public.ts",
    "src/client/shell/activity.ts",
    "src/client/shell/aside-tab.tsx"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
