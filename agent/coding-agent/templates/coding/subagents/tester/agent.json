{
  "name": "tester",
  "display_name": "Tester",
  "role": "tester",
  "scope": "subagent",
  "subagent_kind": "task",
  "description": "测试员子 Agent：编写/运行单元与集成测试，必要时用浏览器做页面或 E2E 核对。能写测试文件、跑命令、use_browser。不修被测业务代码。",
  "status": "active",
  "round_limit": 25,
  "max_retries": 8,
  "terminal_mode": "auto",
  "enable_loop": true,
  "persist_context": true,
  "inherit_full_context": false,
  "permission": "scoped_write",
  "tool_preset": "coding_scoped",
  "tools": [
    "reader",
    "write_file",
    "edit_file",
    "glob",
    "grep",
    "find_code",
    "use_terminal",
    "use_browser",
    "todo_finish"
  ],
  "list_in_manager": true,
  "use_executor": true,
  "over_round_policy": "wrap_up",
  "ephemeral": false,
  "storage_scope": "nested"
}
