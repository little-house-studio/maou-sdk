{
  "name": "use_computer",
  "description": "本机桌面控制（MCP 式门面）。网页用 use_browser。list 拿目录；call 执行。截图：call name=screenshot。",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "description": "list | call | screenshot | snapshot | click | …"
      },
      "reason": {
        "type": "string",
        "description": "为什么必须调用此工具？"
      },
      "name": {
        "type": "string",
        "description": "call 的操作名，如 screenshot / click"
      },
      "arguments": {
        "type": "object",
        "description": "call 的参数"
      },
      "target": {
        "type": "string",
        "description": "元素编号，如 [3]。先 snapshot 再点。"
      },
      "snapshot": {
        "type": "string",
        "description": "snapshot 返回的 snapshotId"
      },
      "text": {
        "type": "string",
        "description": "type / press 的文本或按键名"
      },
      "app": {
        "type": "string",
        "description": "应用名或 bundle id。省略则用前台应用。"
      },
      "window": {
        "type": "string",
        "description": "窗口标题（可选）"
      },
      "pid": {
        "type": "integer",
        "description": "目标进程 PID"
      },
      "keys": {
        "type": "array",
        "items": { "type": "string" },
        "description": "hotkey 组合，如 [\"cmd\",\"s\"]"
      },
      "amount": {
        "type": "number",
        "description": "scroll 行数，正数向上"
      },
      "x": {
        "type": "number",
        "description": "屏幕坐标 X"
      },
      "y": {
        "type": "number",
        "description": "屏幕坐标 Y"
      },
      "include_image": {
        "type": "boolean",
        "description": "snapshot 是否附带截图"
      },
      "duration_ms": {
        "type": "integer",
        "description": "record 时长，默认 2000"
      },
      "path": {
        "type": "string",
        "description": "screenshot/record 保存路径"
      },
      "mode": {
        "type": "string",
        "enum": ["auto", "ax", "pixels"],
        "description": "覆盖本次路线。"
      },
      "description": {
        "type": "string",
        "description": "一句话说明这次调用在做什么。"
      }
    },
    "required": ["description", "action", "reason"],
    "additionalProperties": false
  }
}
