{
  "name": "@little-house-studio/agent",
  "version": "0.1.0",
  "description": "Maou SDK Agent 层（agentLoop 极简循环 + IAgentLoop 可扩展接口 + 提示词编译/token追踪/注册表/事件总线/技能等扩展件）",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./proactive": {
      "types": "./dist/agent/proactive/index.d.ts",
      "import": "./dist/agent/proactive/index.js",
      "default": "./dist/agent/proactive/index.js"
    },
    "./proactive/types": {
      "types": "./dist/agent/proactive/types.d.ts",
      "import": "./dist/agent/proactive/types.js",
      "default": "./dist/agent/proactive/types.js"
    },
    "./proactive/board-format": {
      "types": "./dist/agent/proactive/board-format.d.ts",
      "import": "./dist/agent/proactive/board-format.js",
      "default": "./dist/agent/proactive/board-format.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:mcp": "node scripts/mcp-coding-smoke.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@little-house-studio/context": "workspace:*",
    "@little-house-studio/llm": "workspace:*",
    "@little-house-studio/prompt": "workspace:*",
    "@little-house-studio/tools": "workspace:*",
    "@little-house-studio/types": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
